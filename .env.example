# ===== Backend (apps/backend/.env) =====
# SQLite cho dev
DATABASE_URL="file:./dev.db"

PORT=4000
FRONTEND_URL=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001

# Bắt buộc đổi trong production (chuỗi ngẫu nhiên >= 32 ký tự)
JWT_SECRET=change-me-to-a-long-random-secret
JWT_REFRESH_SECRET=change-me-to-another-long-random-secret

# ===== Customer web (apps/web/.env.local) =====
NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000

# ===== Admin (apps/admin/.env.local) =====
NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
