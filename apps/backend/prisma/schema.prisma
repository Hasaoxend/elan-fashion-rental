// Prisma schema — Fashion Rental System
// Provider: SQLite cho dev (đổi sang PostgreSQL bằng cách sửa datasource + nạp lại migration).
// Lưu ý: SQLite không hỗ trợ enum, các trường trạng thái dùng String kèm hằng số trong src/constants.ts

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============ AUTH & PHÂN QUYỀN ============

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  isSystem    Boolean          @default(false)
  users       User[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model Permission {
  id          String           @id @default(cuid())
  code        String           @unique // ví dụ: product.create
  description String?
  roles       RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model User {
  id           String  @id @default(cuid())
  email        String  @unique
  phone        String?
  passwordHash String
  fullName     String
  avatarUrl    String?
  isActive     Boolean @default(true)
  /// Bắt buộc đổi mật khẩu ở lần đăng nhập đầu tiên
  mustChangePassword Boolean @default(false)
  failedLoginAttempts Int @default(0)
  lockedUntil  DateTime?

  roleId  String
  role    Role    @relation(fields: [roleId], references: [id])
  customer Customer?

  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]
  bookingStatusHistories BookingStatusHistory[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([roleId])
  @@index([email])
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Customer {
  id     String @id @default(cuid())
  email  String @unique
  phone  String
  fullName String
  address String?
  note   String?

  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  status String @default("active") // active | blocked

  bookings Booking[]
  reviews  Review[]
  wishlist WishlistItem[]

  totalSpent Int @default(0)
  totalOrders Int @default(0)
  lastOrderAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([phone])
  @@index([createdAt])
}

model WishlistItem {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([customerId, productId])
  @@index([productId])
}

// ============ CATALOG ============

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  imageUrl    String?
  isActive    Boolean   @default(true)
  sortOrder   Int       @default(0)

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

model Product {
  id       String @id @default(cuid())
  sku      String @unique
  name     String
  slug     String @unique
  description String
  shortDescription String?

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  // Giá tính bằng VND, lưu dạng Int
  pricePerDay   Int
  price3Days    Int
  price7Days    Int
  depositAmount Int @default(0)
  serviceFeeRate Float @default(0.05) // 5% phí dịch vụ

  brand    String?
  material String?
  colorName String?
  sizeLabel String?
  videoUrl  String?

  /// available | reserved | rented | maintenance | inactive
  status String @default("available")
  isActive Boolean @default(true)
  isFeatured Boolean @default(false)

  ratingAvg   Float @default(0)
  ratingCount Int   @default(0)
  rentalCount Int   @default(0)

  images   ProductImage[]
  variants ProductVariant[]
  items    BookingItem[]
  wishlists WishlistItem[]
  reviews  Review[]
  maintenances Maintenance[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([status])
  @@index([isActive, createdAt])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  altText   String?
  sortOrder Int     @default(0)

  @@index([productId])
}

model ProductVariant {
  id        String @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  size      String
  color     String
  /// Tổng số lượng tồn của biến thể này
  stockTotal Int @default(0)
  /// Số lượng đang hỏng / mất
  stockBroken Int @default(0)
  /// Số lượng đang giặt hoặc bảo trì (được trừ khỏi tồn khả dụng)
  stockReservedForMaintenance Int @default(0)
  pricePerDay Int?

  items    BookingItem[]
  inventoryTransactions InventoryTransaction[]

  @@unique([productId, size, color])
  @@index([productId])
}

// ============ BOOKING ============

model Booking {
  id          String  @id @default(cuid())
  /// Mã hiển thị dạng #BK202610070001
  bookingCode String  @unique
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  /// pending | confirmed | preparing | delivering | picked_up | returned | completed | cancelled | rejected
  status      String  @default("pending")
  /// pending | paid | partial | refunded | failed | cancelled
  paymentStatus String @default("pending")

  pickupDate  DateTime
  returnDate  DateTime
  rentalDays  Int

  subtotal    Int @default(0)
  discount    Int @default(0)
  deposit     Int @default(0)
  shippingFee Int @default(0)
  serviceFee  Int @default(0)
  total       Int @default(0)

  /// store_pickup | home_delivery
  deliveryMethod String @default("store_pickup")
  /// cod | bank_transfer | qr | ewallet | online
  paymentMethod   String @default("cod")
  address      String?
  note         String?

  couponCode String?

  createdById String?
  items       BookingItem[]
  history     BookingStatusHistory[]
  payments    Payment[]
  inventoryTransactions InventoryTransaction[]

  cancelledAt   DateTime?
  cancelReason  String?
  completedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([status])
  @@index([pickupDate, returnDate])
  @@index([createdAt])
}

model BookingItem {
  id        String  @id @default(cuid())
  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  size   String
  color  String
  quantity Int @default(1)

  pricePerDay  Int
  rentalDays   Int
  lineSubtotal Int
  lineDeposit  Int

  @@index([productId])
  @@index([bookingId])
}

model BookingStatusHistory {
  id        String  @id @default(cuid())
  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  fromStatus String?
  toStatus   String
  note       String?
  changedById String?
  changedBy  User?   @relation(fields: [changedById], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())

  @@index([bookingId])
}

// ============ KHO & BẢO TRÌ ============

model InventoryTransaction {
  id        String  @id @default(cuid())
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  bookingId String?
  booking   Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  /// in | out | maintenance_in | maintenance_out | adjust | damage | lost | cleaning_out | cleaning_in
  type      String
  quantity  Int
  balanceAfter Int
  reason    String?
  createdById String?
  createdAt DateTime @default(now())

  @@index([variantId])
  @@index([createdAt])
}

model Maintenance {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId String?

  reason      String
  startDate   DateTime
  endDate     DateTime
  cost        Int     @default(0)
  note        String?
  /// open | in_progress | done | cancelled
  status      String  @default("open")
  createdById String?
  completedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([productId])
  @@index([startDate, endDate])
}

// ============ THANH TOÁN ============

model Payment {
  id        String  @id @default(cuid())
  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  /// deposit | rental_fee | shipping | refund
  type      String  @default("rental_fee")
  amount    Int
  /// pending | paid | partial | refunded | failed | cancelled
  status    String  @default("pending")
  method    String  @default("cod")
  /// Mã giao dịch từ provider (VNPay/MoMo/ZaloPay/Stripe) — null với COD
  provider  String?
  providerTxnId String?
  paidAt    DateTime?
  note      String?

  transactions PaymentTransaction[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([bookingId])
  @@index([status])
}

model PaymentTransaction {
  id        String  @id @default(cuid())
  paymentId String
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  /// pay | refund | adjust
  type      String
  amount    Int
  status    String  @default("pending")
  reference String?
  note      String?
  createdAt DateTime @default(now())

  @@index([paymentId])
}

// ============ KHÁC ============

model Coupon {
  id             String    @id @default(cuid())
  code           String    @unique
  description    String?
  discountType   String    @default("percent") // percent | fixed
  discountValue  Int
  minOrderAmount Int       @default(0)
  maxDiscount    Int?
  usageLimit     Int?
  usedCount      Int       @default(0)
  startsAt       DateTime
  expiresAt      DateTime
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())

  @@index([isActive])
}

model Review {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  customerId String
  customer  Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  rating    Int
  comment   String?
  isApproved Boolean @default(false)
  createdAt DateTime @default(now())

  @@index([productId])
  @@index([customerId])
}

model Notification {
  id        String  @id @default(cuid())
  /// new_booking | payment | cancellation | return_due | late_return | maintenance | system
  type      String
  title     String
  body      String?
  /// Đối tượng liên quan để deep-link: booking | payment | product | customer
  entityType String?
  entityId   String?
  /// true = gửi cho toàn bộ admin, false = gửi riêng cho userId
  broadcast  Boolean @default(false)
  userId     String?
  isRead     Boolean @default(false)
  payload    String?
  createdAt  DateTime @default(now())

  @@index([userId, isRead])
  @@index([createdAt])
}

/// Bảng lock dùng để tuần tự hoá giao dịch đặt lịch.
/// SQLite không có SELECT ... FOR UPDATE, nên ta ghi vào một row khoá
/// ở đầu transaction: thao tác ghi buộc SQLite cấp write-lock, khiến hai
/// booking cạnh tranh cùng sản phẩm được xử lý tuần tự thay vì cùng đọc
/// trạng thái cũ rồi cùng ghi đè.
model Lock {
  key       String   @id
  version   Int      @default(0)
  updatedAt DateTime @updatedAt
}

model Setting {
  key       String   @id
  value     String
  group     String   @default("general")
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id        String  @id @default(cuid())
  actorId   String?
  actor     User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorName String?
  action    String
  entityType String
  entityId  String?
  /// JSON string: { before: {...}, after: {...} }
  changes   String?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
}